<Window x:Class="NormaLavoro.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NormaLavoro" Height="600" Width="900">
  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Lista video -->
    <StackPanel Grid.Column="0">
      <TextBlock Text="Elenco Video" FontWeight="Bold" Margin="0,0,0,8"/>
      <ListView ItemsSource="{Binding Videos}" SelectedItem="{Binding SelectedVideo}" DisplayMemberPath="Title" Height="420"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="Aggiorna" Command="{Binding RefreshCommand}" Width="80"/>
        <Button Content="Riproduci" Command="{Binding PlayCommand}" Width="80" Margin="8,0,0,0"/>
      </StackPanel>
    </StackPanel>

    <!-- Dettaglio e riproduzione -->
    <StackPanel Grid.Column="1" Margin="12,0,0,0">
      <TextBlock Text="{Binding SelectedVideo.Title}" FontSize="16" FontWeight="Bold"/>
      <TextBlock Text="{Binding SelectedVideo.Description}" TextWrapping="Wrap" Margin="0,6,0,10"/>
      <!-- MediaElement per riprodurre file locale -->
      <MediaElement Name="mediaPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Height="360"/>
      <TextBlock Text="{Binding SelectedVideo.FilePath}" FontSize="12" Margin="0,6,0,0"/>
    </StackPanel>
  </Grid>
</Window>